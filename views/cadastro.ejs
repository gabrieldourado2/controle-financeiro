<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro</title>
    <link rel="stylesheet" href="../css/cadastro.css">
</head>
<body>
    <form action="/cadastro" method="post">

        <h1>Controle Financeiro</h1>
        <h2>Cadastro</h2>
        <h3>Cadastre-se para continuar</h3>

        
        <div class="inputs">
                <% var erros = { 
                     nome: validacaoArray.find((erro) => {return erro.path === 'nome'}), 
                     email: validacaoArray.find((erro) => {return erro.path === 'email'}),
                     senha: validacaoArray.find((erro) => {return erro.path === 'senha'}), 
                     confirmarSenha: validacaoArray.find((erro) => {return erro.path === 'confirmarSenha'}) 
                 } %>
            <div class="campo">
            <label for="nome">Nome</label>
            <input type="text" placeholder="Nome" name="nome" id="nome" class="<%= erros.nome !== undefined ? 'erro' : '' %>">
            <% if(erros.nome !== undefined){ %>
                <span class="mensagem-erro">
                    <%=erros.nome.msg%>
                </span>
            <% } %>
            </div>

            <div class="campo">
            <label for="email">Email</label>
            <input type="email" placeholder="Email" name="email" id="email" class="<%= erros.email !== undefined ? 'erro' : '' %>">
            <% if(erros.email !== undefined){ %>
                <span class="mensagem-erro">
                    <%= erros.email.msg %>
                </span>
            <% } %>
            </div>

            <div class="campo">
            <label for="senha">Senha</label>
            <input type="password" placeholder="Senha" name="senha" id="senha" class="<%= erros.senha !== undefined ? 'erro' : '' %>">
            <%if(erros.senha !== undefined){ %>
                <span class="mensagem-erro">
                    <%=erros.senha.msg%>
                </span>
            <%}%>
            </div>
            
            <div class="campo">
            <label for="confirmarSenha">Confirmar Senha</label>
            <input type="password" placeholder="Confirme sua senha" name="confirmarSenha" id="confirmarSenha" class="<%= erros.confirmarSenha !== undefined ? 'erro' : '' %>">
            <%if(erros.confirmarSenha !== undefined){%>
                <span class="mensagem-erro">
                    <%=erros.confirmarSenha.msg%>
                </span>
            <%}%>
            </div>

        </div>

        <div class="botao">
            <button>Criar conta</button>
        </div>
        
        <p>Já tem uma conta?<a href="/">Entrar</a></p>
    </form>
</body>
</html>

