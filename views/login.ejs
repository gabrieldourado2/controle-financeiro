<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Controle Financeiro</title>
    <link rel="stylesheet" href="../css/login.css">
</head>
<body>
    <form method="post" action="/login">
        <h1>Controle Financeiro</h1>
        
        <h2>Login</h2>
        <h3>Faça login para continuar</h3>

        <div class="inputs">
            <% var erros = {
                email: validacaoArray.find((erro) =>{return erro.path === 'email'}),
                senha: validacaoArray.find((erro) =>{return erro.path === 'senha'}),
                loginValido: validacaoArray.find((erro) => {return erro.msg === 'Email ou Senha inválidos'})
            }%>

            <div class="campo">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" placeholder="Email" class="<%= erros.email || erros.loginValido !== undefined ? 'erro' : '' %>">
                <% if(erros.email !== undefined){%>
                    <span class="mensagem-erro">
                        <%= erros.email !== undefined ? erros.email.msg : ''%>
                    </span>
                    <%}%> 
            </div>
         
            <div class="campo">
                <label for="senha">Senha</label>
                <input type="password" id="senha" name="senha" placeholder="Senha" class="<%= erros.senha || erros.loginValido !== undefined ? 'erro' : '' %>">
                <% if(erros.senha !== undefined){%>
                    <span class="mensagem-erro">
                        <%= erros.senha !== undefined ? erros.senha.msg : ''%>
                    </span>
                    <%}%> 
            </div>
                    
        </div>


            <% if(erros.loginValido !== undefined){%>
                <span class="mensagem-erro">
                    <%= erros.loginValido !== undefined ? erros.loginValido.msg : ''%>
                </span>
            <%}%> 
        <div class="botao">
            <button>Entrar</button>
        </div>
        <p>Não tem conta? <a href="/cadastro">Cadastre-se</a></p>
    </form>
</body>
</html>